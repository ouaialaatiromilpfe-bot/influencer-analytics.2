# Copy to .env.local for local dev, and set the same keys in
# Netlify → Site settings → Environment variables for production.

# Optional server-side fallback used when a visitor doesn't paste their own key.
YOUTUBE_API_KEY=

# Optional server-side fallback used when a visitor doesn't paste their own token.
APIFY_TOKEN=

# The exact Apify actor to run, format "username~actor-name".
# Defaults to "apify~instagram-scraper" if unset — VERIFY this matches the
# actor you actually want to bill against your Apify account.
APIFY_ACTOR_ID=apify~instagram-scraper
